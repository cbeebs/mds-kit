{
  "manifest_version": 3,
  "name": "MDS Kit",
  "version": "1.0.0",
  "description": "Marathon des Sables kit planner",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}
